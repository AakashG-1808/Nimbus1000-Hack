# OpenWeatherMap API Configuration
OPENWEATHERMAP_API_KEY=your_api_key_here
OPENWEATHERMAP_CITY=Bengaluru
OPENWEATHERMAP_COUNTRY_CODE=IN

# AWS Bedrock Configuration
AWS_REGION=ap-south-2
AWS_BEDROCK_REGION=ap-south-2
AWS_ACCESS_KEY_ID=your_access_key_here
AWS_SECRET_ACCESS_KEY=your_secret_key_here
BEDROCK_MODEL_ID=global.anthropic.claude-haiku-4-5-20251001-v1:0

# DynamoDB Storage Configuration
# Set USE_DYNAMODB=true to persist data to DynamoDB instead of in-memory storage
USE_DYNAMODB=false

# DynamoDB table names (defaults match the SAM template)
DYNAMODB_TABLE_COMPLAINTS=urbanguard-complaints
DYNAMODB_TABLE_RISK_ZONES=urbanguard-risk-zones
DYNAMODB_TABLE_REPORTS=urbanguard-reports
DYNAMODB_TABLE_USERS=urbanguard-users

# For DynamoDB Local (local development without a real AWS account)
# Download DynamoDB Local from https://docs.aws.amazon.com/amazondynamodb/latest/developerguide/DynamoDBLocal.html
# Then run: java -jar DynamoDBLocal.jar -sharedDb -port 8001
# Uncomment the line below and set USE_DYNAMODB=true
# DYNAMODB_ENDPOINT_URL=http://localhost:8001

# Authentication
# Change this to a strong random secret in production!
JWT_SECRET=urbanguard-dev-secret-key-change-in-production

# Application Configuration
ENVIRONMENT=development
LOG_LEVEL=INFO
